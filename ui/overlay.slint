// UI del overlay, con colores y marcos inspirados en la interfaz de Albion:
// marrones oscuros, bordes dorados y texto pergamino.
// Las ventanas del overlay no tienen marco ni transparencia: las esquinas
// redondeadas las recorta Windows con una región (SetWindowRgn).

global Palette {
    out property <color> bg: #15100c;
    out property <color> panel: #211812;
    out property <color> slot-bg: #0e0a07;
    out property <color> slot-hover: #2a1f16;
    out property <color> border: #4a3826;
    out property <color> frame: #7a5c36;
    out property <color> gold: #d6ad5e;
    out property <color> gold-bright: #f0cf86;
    out property <color> text: #f2e7d2;
    out property <color> muted: #a89679;
    out property <color> icon: #c9b48f;
    out property <color> warn: #ffb454;
    out property <color> error: #ff7a6b;
    out property <color> tooltip-bg: #1a130e;
}

// Textos de las ventanas; Rust los llena según el idioma elegido (src/i18n.rs).
export global Tr {
    in property <string> code-title: "Entrá a tu party";
    in property <string> code-help;
    in property <string> code-label: "CÓDIGO DE LA ASIGNACIÓN";
    in property <string> continue: "CONTINUAR";
    in property <string> close: "CERRAR";
    in property <string> back: "← Cambiar código";
    in property <string> register-title;
    in property <string> register-help;
    in property <string> name-label;
    in property <string> name-placeholder;
    in property <string> roles-label;
    in property <string> join: "ENTRAR";
    in property <string> leave: "SALIR";
    in property <string> lang-label: "IDIOMA";
    in property <[string]> roles: ["Tank", "Healer", "Support", "DPS rango", "DPS melee", "Montura de batalla"];
    in property <string> no-role: "SIN ROL";
    in property <string> alternative: "Alternativa: ";
}

// Tres puntos que laten: indicador de carga. Solo existe mientras se muestra,
// así no hay redibujo continuo cuando no hace falta.
component Dots inherits Rectangle {
    in property <color> dot-color: Palette.gold;
    width: 30px;
    height: 8px;

    for i in 3: Rectangle {
        x: i * 11px;
        y: 1px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.dot-color;
        opacity: 0.25 + 0.75 * (0.5 + 0.5 * sin((animation-tick() / 1ms) * 0.4deg - i * 70deg));
    }
}

export struct Slot {
    // Comandos SVG del ícono de reemplazo (viewBox 24x24), mientras carga el real.
    icon: string,
    image: image,
    has-image: bool,
    // "8", "8.1"... se muestra solo sobre el ícono de reemplazo.
    tier: string,
    tier-color: color,
    // .1 a .4: el borde toma el color del encantamiento.
    enchanted: bool,
    empty: bool,
}

export struct Member {
    name: string,
    role: string,
    role-color: color,
    assigned: bool,
    me: bool,
    image: image,
    has-image: bool,
}

component SlotView inherits Rectangle {
    in property <Slot> slot;
    in property <bool> hovered;

    width: 38px;
    height: 38px;
    border-radius: 4px;
    border-width: 1px;
    background: hovered ? Palette.slot-hover : Palette.slot-bg;
    border-color: slot.enchanted ? slot.tier-color : (hovered ? Palette.gold : Palette.border);
    opacity: slot.empty ? 0.35 : 1.0;

    if slot.has-image: Image {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        source: slot.image;
        image-fit: contain;
        // Aparece suave cuando termina de bajar el ícono.
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 220ms; easing: ease-out; }
    }

    if !slot.has-image: Path {
        width: 19px;
        height: 19px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: slot.icon;
        stroke: hovered ? Palette.text : Palette.icon;
        stroke-width: 1.6px;
        stroke-line-cap: round;
        fill: transparent;
    }

    if !slot.has-image && !slot.empty && slot.tier != "": Text {
        x: parent.width - self.width - 3px;
        y: parent.height - self.height - 1px;
        text: slot.tier;
        color: slot.tier-color;
        font-size: 9px;
        font-weight: 700;
    }
}

component PartyButton inherits Rectangle {
    in property <bool> active;
    in property <string> count;
    callback clicked();
    callback right-clicked();

    width: 38px;
    height: 38px;
    border-radius: 4px;
    border-width: 1px;
    background: touch.has-hover || active ? Palette.slot-hover : Palette.slot-bg;
    border-color: active ? Palette.gold-bright : Palette.frame;

    Path {
        y: 7px;
        width: 20px;
        height: 18px;
        viewbox-width: 24;
        viewbox-height: 22;
        commands: "M9 9a3.5 3.5 0 1 0 0-7a3.5 3.5 0 1 0 0 7M2 20c0-4 3-6.5 7-6.5s7 2.5 7 6.5M16 2.6a3.5 3.5 0 0 1 0 6.8M18.5 13.8c2.2.8 3.5 2.9 3.5 6.2";
        stroke: active || touch.has-hover ? Palette.gold-bright : Palette.gold;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        fill: transparent;
    }

    Text {
        y: parent.height - self.height - 1px;
        text: count;
        color: Palette.gold;
        font-size: 9px;
        font-weight: 700;
        horizontal-alignment: center;
        width: parent.width;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                root.right-clicked();
            }
        }
    }
}

export component OverlayWindow inherits Window {
    in property <bool> pill-mode;
    in property <bool> click-through;
    in property <[Slot]> slots;
    in property <string> role;
    in property <color> role-color;
    in property <string> main-name;
    in property <string> main-tier;
    in property <color> main-tier-color;
    // Nombre de la build asignada (segunda línea de la celda del rol).
    in property <string> build-name;
    // Mensaje cuando no hay build para mostrar (sin código, esperando, expirada...).
    in property <string> status-text;
    in property <color> status-color: Palette.muted;
    in property <bool> party-open;
    in property <string> party-count;
    // Muestra los puntos de carga junto al mensaje.
    in property <bool> loading;
    // Ancho de la zona de mensaje cuando no hay casilleros (8 casilleros).
    in property <length> message-width: 332px;
    in-out property <int> hovered-slot: -1;

    // index, true al entrar / false al salir.
    callback slot-hover(int, bool);
    callback party-clicked();
    callback open-setup();
    // Clic en el mensaje (abre el ingreso si no hay código, o reintenta).
    callback status-clicked();

    title: "AlbionCompo";
    no-frame: true;
    always-on-top: true;
    default-font-family: "Segoe UI";
    background: Palette.bg;

    // Marco doble como los paneles del juego (la región recorta las esquinas).
    Rectangle {
        border-width: 1px;
        border-radius: pill-mode ? 17px : 7px;
        border-color: click-through ? Palette.gold-bright : Palette.frame;

        Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            border-width: 1px;
            border-radius: pill-mode ? 15px : 5px;
            border-color: #2b2016;
        }
    }

    if pill-mode: HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 9px;

        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.role-color;
        }

        Text {
            text: root.role;
            color: root.role-color;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.4px;
            vertical-alignment: center;
        }

        Rectangle {
            width: 1px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            background: Palette.border;
        }

        Text {
            text: root.slots.length > 0 ? root.main-name : root.status-text;
            color: root.slots.length > 0 ? Palette.text : root.status-color;
            font-size: 12.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.slots.length > 0: Text {
            text: root.main-tier;
            color: root.main-tier-color;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }

    }

    if pill-mode: TouchArea {
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                root.open-setup();
            }
        }
    }

    if !pill-mode: HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 4px;

        // Celda del rol: lo que asignó el líder, antes de los ítems.
        if root.slots.length > 0: Rectangle {
            width: 84px;
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.border;
            background: Palette.slot-bg;

            Rectangle {
                x: 1px;
                y: 5px;
                width: 3px;
                height: parent.height - 10px;
                border-radius: 1.5px;
                background: root.role-color;
            }

            VerticalLayout {
                padding-left: 10px;
                padding-right: 5px;
                alignment: center;
                spacing: 1px;

                Text {
                    text: root.role != "" ? root.role : Tr.no-role;
                    color: root.role-color;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                    overflow: elide;
                }

                if root.build-name != "": Text {
                    text: root.build-name;
                    color: Palette.muted;
                    font-size: 10px;
                    overflow: elide;
                }
            }

            TouchArea {
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                        root.open-setup();
                    }
                }
            }
        }

        for slot[i] in root.slots: SlotView {
            slot: slot;
            hovered: root.hovered-slot == i;

            TouchArea {
                changed has-hover => {
                    root.hovered-slot = self.has-hover ? i : (root.hovered-slot == i ? -1 : root.hovered-slot);
                    root.slot-hover(i, self.has-hover);
                }
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                        root.open-setup();
                    }
                }
            }
        }

        if root.slots.length == 0: Rectangle {
            width: root.message-width;
            border-radius: 4px;
            background: message-touch.has-hover ? Palette.slot-hover : Palette.slot-bg;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                if root.role != "": Rectangle {
                    width: 8px;
                    height: 8px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: root.role-color;
                }

                if root.role != "": Text {
                    text: root.role;
                    color: root.role-color;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 1.2px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.status-text;
                    color: root.status-color;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if root.loading: Dots {
                    y: (parent.height - self.height) / 2;
                }
            }

            message-touch := TouchArea {
                clicked => { root.status-clicked(); }
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                        root.open-setup();
                    }
                }
            }
        }

        PartyButton {
            active: root.party-open;
            count: root.party-count;
            clicked => { root.party-clicked(); }
            right-clicked => { root.open-setup(); }
        }
    }
}

// Tooltip: ventana aparte que se crea ~300 ms después del hover y se destruye al salir.
export component TooltipWindow inherits Window {
    in property <string> item-name;
    in property <string> slot-label;
    in property <string> tier;
    in property <color> tier-color;
    in property <string> alt-name;

    title: "AlbionCompo";
    no-frame: true;
    always-on-top: true;
    default-font-family: "Segoe UI";
    background: Palette.tooltip-bg;

    Rectangle {
        border-width: 1px;
        border-radius: 6px;
        border-color: Palette.frame;
    }

    VerticalLayout {
        padding-left: 11px;
        padding-right: 11px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 2px;

        Text {
            text: root.item-name;
            color: Palette.gold-bright;
            font-size: 13px;
            font-weight: 600;
        }

        HorizontalLayout {
            alignment: start;

            Text {
                text: root.slot-label;
                color: Palette.muted;
                font-size: 11px;
            }

            if root.tier != "": Text {
                text: " · ";
                color: Palette.muted;
                font-size: 11px;
            }

            if root.tier != "": Text {
                text: "T" + root.tier;
                color: root.tier-color;
                font-size: 11px;
                font-weight: 700;
            }
        }

        if root.alt-name != "": Text {
            text: Tr.alternative + root.alt-name;
            color: Palette.muted;
            font-size: 11px;
            font-italic: true;
        }
    }
}

// Panel de la party: se despliega con el botón de la derecha de la tira.
export component PartyWindow inherits Window {
    in property <string> heading;
    in property <string> subheading;
    in property <[Member]> members;

    title: "AlbionCompo";
    no-frame: true;
    always-on-top: true;
    default-font-family: "Segoe UI";
    background: Palette.bg;

    Rectangle {
        border-width: 1px;
        border-radius: 7px;
        border-color: Palette.frame;
    }

    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        alignment: start;

        Text {
            text: root.heading;
            color: Palette.gold;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.4px;
            overflow: elide;
        }

        Text {
            text: root.subheading;
            color: Palette.muted;
            font-size: 11px;
        }

        Rectangle {
            height: 7px;

            Rectangle {
                y: 3px;
                height: 1px;
                background: Palette.border;
            }
        }

        for member in root.members: Rectangle {
            height: 26px;
            border-radius: 3px;
            background: member.me ? #2a1f16 : transparent;

            HorizontalLayout {
                padding-left: 4px;
                padding-right: 6px;
                spacing: 7px;

                Rectangle {
                    width: 22px;
                    height: 22px;
                    y: 2px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: Palette.border;
                    background: Palette.slot-bg;

                    if member.has-image: Image {
                        x: 1px;
                        y: 1px;
                        width: 20px;
                        height: 20px;
                        source: member.image;
                        image-fit: contain;
                    }

                    if !member.has-image: Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: member.role-color;
                    }
                }

                Text {
                    text: member.name;
                    color: member.me ? Palette.gold-bright : (member.assigned ? Palette.text : Palette.muted);
                    font-size: 12px;
                    font-weight: member.me ? 700 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Text {
                    text: member.role;
                    color: member.role-color;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component Field inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> enabled: true;
    in property <bool> upper;
    // Campo grande y centrado (el código).
    in property <bool> big;
    callback accepted();
    callback edited(string);

    height: big ? 66px : 52px;
    forward-focus: input;

    VerticalLayout {
        spacing: 4px;

        Text {
            text: root.label;
            color: Palette.muted;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
        }

        Rectangle {
            height: root.big ? 46px : 32px;
            border-radius: 4px;
            border-width: 1px;
            border-color: input.has-focus ? Palette.gold : Palette.border;
            background: Palette.slot-bg;
            animate border-color { duration: 160ms; }

            if root.text == "" && !input.has-focus: Text {
                x: 10px;
                width: parent.width - 20px;
                text: root.placeholder;
                color: #6d5f4b;
                font-size: root.big ? 22px : 13px;
                letter-spacing: root.big ? 6px : 0px;
                horizontal-alignment: root.big ? center : left;
                vertical-alignment: center;
                height: parent.height;
            }

            input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text <=> root.text;
                enabled: root.enabled;
                color: Palette.text;
                selection-background-color: #6b5230;
                font-size: root.big ? 22px : 13px;
                font-weight: root.big ? 600 : 400;
                letter-spacing: root.big ? 6px : 0px;
                horizontal-alignment: root.big ? center : left;
                vertical-alignment: center;
                single-line: true;
                accepted => { root.accepted(); }
                edited => {
                    if root.upper && self.text != self.text.to-uppercase() {
                        self.text = self.text.to-uppercase();
                    }
                    root.edited(self.text);
                }
            }
        }
    }

    public function focus-input() {
        input.focus();
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <color> accent: Palette.gold;
    in property <bool> enabled: true;
    callback clicked();

    height: 28px;
    min-width: chip-text.preferred-width + 22px;
    border-radius: 14px;
    border-width: 1px;
    border-color: selected ? accent : (touch.has-hover ? Palette.frame : Palette.border);
    background: selected ? accent.with-alpha(0.16) : (touch.has-hover ? Palette.slot-hover : Palette.slot-bg);
    opacity: enabled ? 1.0 : 0.5;
    animate background, border-color { duration: 140ms; }

    chip-text := Text {
        text: root.text;
        color: root.selected ? root.accent : (touch.has-hover ? Palette.text : Palette.muted);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.8px;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 140ms; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> busy;
    callback clicked();

    height: 36px;
    min-width: 88px;
    border-radius: 4px;
    border-width: 1px;
    border-color: primary ? (touch.has-hover && enabled ? Palette.gold-bright : Palette.gold) : (touch.has-hover ? Palette.frame : Palette.border);
    background: primary ? (touch.has-hover && enabled ? #5a4325 : #3d2d19) : (touch.has-hover ? Palette.slot-hover : Palette.slot-bg);
    opacity: enabled || busy ? 1.0 : 0.5;
    animate background, border-color { duration: 140ms; }

    if !root.busy: Text {
        text: root.text;
        color: root.primary ? Palette.gold-bright : Palette.text;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.4px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.busy: Dots {
        dot-color: root.primary ? Palette.gold-bright : Palette.text;
    }

    touch := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Ventana para entrar a una asignación, en dos pasos: primero solo el código y,
// si existe, el registro (nombre y roles). Es una ventana normal (con foco)
// porque hay que escribir; se usa fuera de las peleas.
export component SetupWindow inherits Window {
    // 0: código, 1: registro.
    in-out property <int> step: 0;
    in-out property <string> code;
    in-out property <string> name;
    // Roles elegidos como bits (1 = TANK, 2 = HEALER, 4 = SUPPORT...).
    in-out property <int> role-mask: 0;
    in-out property <int> lang-index: 0;
    in property <string> error-text;
    in property <string> info-text;
    in property <string> assignment-name;
    in property <string> assignment-detail;
    in property <bool> busy;
    in property <bool> joined;
    in property <[color]> role-colors: [#6aa8ff, #45d6a0, #f0a830, #ff9a62, #ff7a6b, #c9b48f];

    callback check-code();
    callback submit();
    callback back();
    callback leave();
    callback close-clicked();
    callback lang-changed(int);

    public function focus-code() {
        code-field.focus-input();
    }

    public function focus-name() {
        name-field.focus-input();
    }

    title: "AlbionCompo";
    always-on-top: true;
    default-font-family: "Segoe UI";
    background: Palette.bg;
    width: 400px;
    height: 470px;

    forward-focus: code-field;

    // Entrada suave de la ventana.
    property <bool> shown;
    init => { shown = true; }

    function role-on(i: int) -> bool {
        return Math.mod(Math.floor(root.role-mask / Math.pow(2, i)), 2) == 1;
    }

    function toggle-role(i: int) {
        root.role-mask = root.role-on(i) ? root.role-mask - Math.pow(2, i) : root.role-mask + Math.pow(2, i);
    }

    Rectangle {
        border-width: 1px;
        border-color: Palette.border;
    }

    // Línea dorada arriba, como los paneles del juego.
    Rectangle {
        y: 0;
        height: 2px;
        background: @linear-gradient(90deg, transparent 0%, Palette.gold 50%, transparent 100%);
        opacity: 0.7;
    }

    content := Rectangle {
        opacity: root.shown ? 1 : 0;
        y: root.shown ? 0 : 10px;
        animate opacity { duration: 260ms; easing: ease-out; }
        animate y { duration: 260ms; easing: ease-out; }

        // Encabezado: marca e idioma (cambia la interfaz y los nombres de ítems).
        HorizontalLayout {
            y: 16px;
            x: 22px;
            width: parent.width - 44px;
            height: 28px;
            spacing: 6px;

            Text {
                text: "ALBIONCOMPO";
                color: Palette.gold;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 2.4px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            for lang[i] in ["ES", "EN", "PT"]: Chip {
                text: lang;
                selected: root.lang-index == i;
                clicked => {
                    if root.lang-index != i {
                        root.lang-index = i;
                        root.lang-changed(i);
                    }
                }
            }
        }

        // Paso 1: código.
        Rectangle {
            x: root.step == 0 ? 0 : -60px;
            opacity: root.step == 0 ? 1 : 0;
            visible: self.opacity > 0.01;
            animate x { duration: 240ms; easing: ease-out; }
            animate opacity { duration: 200ms; }

            VerticalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 74px;
                padding-bottom: 20px;
                spacing: 12px;

                Text {
                    text: Tr.code-title;
                    color: Palette.gold-bright;
                    font-size: 22px;
                    font-weight: 600;
                }

                Text {
                    text: Tr.code-help;
                    color: Palette.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 6px;
                }

                code-field := Field {
                    label: Tr.code-label;
                    placeholder: "D75TGV";
                    big: true;
                    upper: true;
                    text <=> root.code;
                    enabled: !root.busy;
                    accepted => { root.check-code(); }
                }

                Text {
                    text: root.error-text;
                    color: Palette.error;
                    font-size: 12px;
                    wrap: word-wrap;
                    min-height: 32px;
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Button {
                        text: Tr.close;
                        clicked => { root.close-clicked(); }
                    }

                    Button {
                        text: Tr.continue;
                        primary: true;
                        busy: root.busy;
                        horizontal-stretch: 2;
                        clicked => { root.check-code(); }
                    }
                }
            }
        }

        // Paso 2: registro.
        Rectangle {
            x: root.step == 1 ? 0 : 60px;
            opacity: root.step == 1 ? 1 : 0;
            visible: self.opacity > 0.01;
            animate x { duration: 240ms; easing: ease-out; }
            animate opacity { duration: 200ms; }

            VerticalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 56px;
                padding-bottom: 20px;
                spacing: 11px;

                back-text := Text {
                    text: Tr.back;
                    color: back-touch.has-hover ? Palette.gold-bright : Palette.muted;
                    font-size: 11px;

                    back-touch := TouchArea {
                        enabled: !root.busy;
                        mouse-cursor: pointer;
                        clicked => { root.back(); }
                    }
                }

                Text {
                    text: Tr.register-title;
                    color: Palette.gold-bright;
                    font-size: 19px;
                    font-weight: 600;
                }

                // Tarjeta de la asignación encontrada.
                Rectangle {
                    height: 48px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Palette.frame;
                    background: Palette.slot-bg;

                    Rectangle {
                        x: 0;
                        width: 3px;
                        border-radius: 1.5px;
                        background: Palette.gold;
                    }

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: root.assignment-name;
                            color: Palette.text;
                            font-size: 13px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        Text {
                            text: root.assignment-detail;
                            color: Palette.muted;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }

                name-field := Field {
                    label: Tr.name-label;
                    placeholder: Tr.name-placeholder;
                    text <=> root.name;
                    enabled: !root.busy;
                    accepted => { root.submit(); }
                }

                Text {
                    text: Tr.roles-label;
                    color: Palette.muted;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 1.0px;
                }

                VerticalLayout {
                    spacing: 6px;

                    for row in 2: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        for col in 3: Chip {
                            text: Tr.roles[row * 3 + col];
                            accent: root.role-colors[row * 3 + col];
                            selected: root.role-on(row * 3 + col);
                            enabled: !root.busy;
                            clicked => { root.toggle-role(row * 3 + col); }
                        }
                    }
                }

                Text {
                    text: root.error-text != "" ? root.error-text : (root.info-text != "" ? root.info-text : Tr.register-help);
                    color: root.error-text != "" ? Palette.error : Palette.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                    min-height: 32px;
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 8px;

                    if root.joined: Button {
                        text: Tr.leave;
                        enabled: !root.busy;
                        clicked => { root.leave(); }
                    }

                    Button {
                        text: Tr.close;
                        clicked => { root.close-clicked(); }
                    }

                    Button {
                        text: Tr.join;
                        primary: true;
                        busy: root.busy;
                        horizontal-stretch: 2;
                        clicked => { root.submit(); }
                    }
                }
            }
        }
    }
}

// Botón flotante con el logo de AlbionCompo, en el borde derecho del juego.
// Sin asignación abre el ingreso; con asignación despliega la party.
// Clic derecho: el mismo menú que el ícono de la bandeja.
export component LauncherWindow inherits Window {
    in property <bool> active;
    in property <bool> show-badge;
    in property <color> badge-color: Palette.gold;
    callback clicked();
    callback right-clicked();

    title: "AlbionCompo";
    no-frame: true;
    always-on-top: true;
    background: Palette.bg;
    width: 48px;
    height: 48px;

    property <bool> shown;
    init => { shown = true; }

    Rectangle {
        border-radius: 24px;
        border-width: 2px;
        border-color: touch.has-hover || root.active ? Palette.gold-bright : Palette.frame;
        background: touch.has-hover ? Palette.slot-hover : Palette.bg;
        animate border-color, background { duration: 150ms; }
    }

    Image {
        x: 4px;
        y: 4px;
        width: 40px;
        height: 40px;
        source: @image-url("../assets/brand-mark-96.png");
        image-fit: contain;
        opacity: root.shown ? (touch.has-hover || root.active ? 1.0 : 0.85) : 0;
        animate opacity { duration: 220ms; easing: ease-out; }
    }

    // Estado: dorado esperando build, color del rol con build, ámbar con problemas.
    if root.show-badge: Rectangle {
        x: 33px;
        y: 5px;
        width: 11px;
        height: 11px;
        border-radius: 5.5px;
        border-width: 2px;
        border-color: Palette.bg;
        background: root.badge-color;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                root.right-clicked();
            }
        }
    }
}
