// UI del overlay, con colores y marcos inspirados en la interfaz de Albion:
// marrones oscuros, bordes dorados y texto pergamino.
// Las ventanas del overlay no tienen marco ni transparencia: las esquinas
// redondeadas las recorta Windows con una región (SetWindowRgn).

global Palette {
    out property <color> bg: #15100c;
    out property <color> panel: #211812;
    out property <color> slot-bg: #0e0a07;
    out property <color> slot-hover: #2a1f16;
    out property <color> border: #4a3826;
    out property <color> frame: #7a5c36;
    out property <color> gold: #d6ad5e;
    out property <color> gold-bright: #f0cf86;
    out property <color> text: #f2e7d2;
    out property <color> muted: #a89679;
    out property <color> icon: #c9b48f;
    out property <color> warn: #ffb454;
    out property <color> error: #ff7a6b;
    out property <color> tooltip-bg: #1a130e;
}

export struct Slot {
    // Comandos SVG del ícono de reemplazo (viewBox 24x24), mientras carga el real.
    icon: string,
    image: image,
    has-image: bool,
    // "8", "8.1"... se muestra solo sobre el ícono de reemplazo.
    tier: string,
    tier-color: color,
    // .1 a .4: el borde toma el color del encantamiento.
    enchanted: bool,
    empty: bool,
}

export struct Member {
    name: string,
    role: string,
    role-color: color,
    assigned: bool,
    me: bool,
    image: image,
    has-image: bool,
}

component SlotView inherits Rectangle {
    in property <Slot> slot;
    in property <bool> hovered;

    width: 38px;
    height: 38px;
    border-radius: 4px;
    border-width: 1px;
    background: hovered ? Palette.slot-hover : Palette.slot-bg;
    border-color: slot.enchanted ? slot.tier-color : (hovered ? Palette.gold : Palette.border);
    opacity: slot.empty ? 0.35 : 1.0;

    if slot.has-image: Image {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        source: slot.image;
        image-fit: contain;
    }

    if !slot.has-image: Path {
        width: 19px;
        height: 19px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: slot.icon;
        stroke: hovered ? Palette.text : Palette.icon;
        stroke-width: 1.6px;
        stroke-line-cap: round;
        fill: transparent;
    }

    if !slot.has-image && !slot.empty && slot.tier != "": Text {
        x: parent.width - self.width - 3px;
        y: parent.height - self.height - 1px;
        text: slot.tier;
        color: slot.tier-color;
        font-size: 9px;
        font-weight: 700;
    }
}

component PartyButton inherits Rectangle {
    in property <bool> active;
    in property <string> count;
    callback clicked();
    callback right-clicked();

    width: 38px;
    height: 38px;
    border-radius: 4px;
    border-width: 1px;
    background: touch.has-hover || active ? Palette.slot-hover : Palette.slot-bg;
    border-color: active ? Palette.gold-bright : Palette.frame;

    Path {
        y: 7px;
        width: 20px;
        height: 18px;
        viewbox-width: 24;
        viewbox-height: 22;
        commands: "M9 9a3.5 3.5 0 1 0 0-7a3.5 3.5 0 1 0 0 7M2 20c0-4 3-6.5 7-6.5s7 2.5 7 6.5M16 2.6a3.5 3.5 0 0 1 0 6.8M18.5 13.8c2.2.8 3.5 2.9 3.5 6.2";
        stroke: active || touch.has-hover ? Palette.gold-bright : Palette.gold;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        fill: transparent;
    }

    Text {
        y: parent.height - self.height - 1px;
        text: count;
        color: Palette.gold;
        font-size: 9px;
        font-weight: 700;
        horizontal-alignment: center;
        width: parent.width;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                root.right-clicked();
            }
        }
    }
}

export component OverlayWindow inherits Window {
    in property <bool> pill-mode;
    in property <bool> click-through;
    in property <[Slot]> slots;
    in property <string> role;
    in property <color> role-color;
    in property <string> main-name;
    in property <string> main-tier;
    in property <color> main-tier-color;
    // Nombre de la build asignada (segunda línea de la celda del rol).
    in property <string> build-name;
    // Mensaje cuando no hay build para mostrar (sin código, esperando, expirada...).
    in property <string> status-text;
    in property <color> status-color: Palette.muted;
    in property <bool> party-open;
    in property <string> party-count;
    // Ancho de la zona de mensaje cuando no hay casilleros (8 casilleros).
    in property <length> message-width: 332px;
    in-out property <int> hovered-slot: -1;

    // index, true al entrar / false al salir.
    callback slot-hover(int, bool);
    callback party-clicked();
    callback open-setup();
    // Clic en el mensaje (abre el ingreso si no hay código, o reintenta).
    callback status-clicked();

    title: "AlbionCompo";
    no-frame: true;
    always-on-top: true;
    default-font-family: "Segoe UI";
    background: Palette.bg;

    // Marco doble como los paneles del juego (la región recorta las esquinas).
    Rectangle {
        border-width: 1px;
        border-radius: pill-mode ? 17px : 7px;
        border-color: click-through ? Palette.gold-bright : Palette.frame;

        Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            border-width: 1px;
            border-radius: pill-mode ? 15px : 5px;
            border-color: #2b2016;
        }
    }

    if pill-mode: HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 9px;

        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.role-color;
        }

        Text {
            text: root.role;
            color: root.role-color;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.4px;
            vertical-alignment: center;
        }

        Rectangle {
            width: 1px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            background: Palette.border;
        }

        Text {
            text: root.slots.length > 0 ? root.main-name : root.status-text;
            color: root.slots.length > 0 ? Palette.text : root.status-color;
            font-size: 12.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.slots.length > 0: Text {
            text: root.main-tier;
            color: root.main-tier-color;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }

    }

    if pill-mode: TouchArea {
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                root.open-setup();
            }
        }
    }

    if !pill-mode: HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 4px;

        // Celda del rol: lo que asignó el líder, antes de los ítems.
        if root.slots.length > 0: Rectangle {
            width: 84px;
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.border;
            background: Palette.slot-bg;

            Rectangle {
                x: 1px;
                y: 5px;
                width: 3px;
                height: parent.height - 10px;
                border-radius: 1.5px;
                background: root.role-color;
            }

            VerticalLayout {
                padding-left: 10px;
                padding-right: 5px;
                alignment: center;
                spacing: 1px;

                Text {
                    text: root.role != "" ? root.role : "SIN ROL";
                    color: root.role-color;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                    overflow: elide;
                }

                if root.build-name != "": Text {
                    text: root.build-name;
                    color: Palette.muted;
                    font-size: 10px;
                    overflow: elide;
                }
            }

            TouchArea {
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                        root.open-setup();
                    }
                }
            }
        }

        for slot[i] in root.slots: SlotView {
            slot: slot;
            hovered: root.hovered-slot == i;

            TouchArea {
                changed has-hover => {
                    root.hovered-slot = self.has-hover ? i : (root.hovered-slot == i ? -1 : root.hovered-slot);
                    root.slot-hover(i, self.has-hover);
                }
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                        root.open-setup();
                    }
                }
            }
        }

        if root.slots.length == 0: Rectangle {
            width: root.message-width;
            border-radius: 4px;
            background: message-touch.has-hover ? Palette.slot-hover : Palette.slot-bg;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                if root.role != "": Rectangle {
                    width: 8px;
                    height: 8px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: root.role-color;
                }

                if root.role != "": Text {
                    text: root.role;
                    color: root.role-color;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 1.2px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.status-text;
                    color: root.status-color;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }

            message-touch := TouchArea {
                clicked => { root.status-clicked(); }
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                        root.open-setup();
                    }
                }
            }
        }

        PartyButton {
            active: root.party-open;
            count: root.party-count;
            clicked => { root.party-clicked(); }
            right-clicked => { root.open-setup(); }
        }
    }
}

// Tooltip: ventana aparte que se crea ~300 ms después del hover y se destruye al salir.
export component TooltipWindow inherits Window {
    in property <string> item-name;
    in property <string> slot-label;
    in property <string> tier;
    in property <color> tier-color;
    in property <string> alt-name;

    title: "AlbionCompo";
    no-frame: true;
    always-on-top: true;
    default-font-family: "Segoe UI";
    background: Palette.tooltip-bg;

    Rectangle {
        border-width: 1px;
        border-radius: 6px;
        border-color: Palette.frame;
    }

    VerticalLayout {
        padding-left: 11px;
        padding-right: 11px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 2px;

        Text {
            text: root.item-name;
            color: Palette.gold-bright;
            font-size: 13px;
            font-weight: 600;
        }

        HorizontalLayout {
            alignment: start;

            Text {
                text: root.slot-label;
                color: Palette.muted;
                font-size: 11px;
            }

            if root.tier != "": Text {
                text: " · ";
                color: Palette.muted;
                font-size: 11px;
            }

            if root.tier != "": Text {
                text: "T" + root.tier;
                color: root.tier-color;
                font-size: 11px;
                font-weight: 700;
            }
        }

        if root.alt-name != "": Text {
            text: "Alternativa: " + root.alt-name;
            color: Palette.muted;
            font-size: 11px;
            font-italic: true;
        }
    }
}

// Panel de la party: se despliega con el botón de la derecha de la tira.
export component PartyWindow inherits Window {
    in property <string> heading;
    in property <string> subheading;
    in property <[Member]> members;

    title: "AlbionCompo";
    no-frame: true;
    always-on-top: true;
    default-font-family: "Segoe UI";
    background: Palette.bg;

    Rectangle {
        border-width: 1px;
        border-radius: 7px;
        border-color: Palette.frame;
    }

    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        alignment: start;

        Text {
            text: root.heading;
            color: Palette.gold;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.4px;
            overflow: elide;
        }

        Text {
            text: root.subheading;
            color: Palette.muted;
            font-size: 11px;
        }

        Rectangle {
            height: 7px;

            Rectangle {
                y: 3px;
                height: 1px;
                background: Palette.border;
            }
        }

        for member in root.members: Rectangle {
            height: 26px;
            border-radius: 3px;
            background: member.me ? #2a1f16 : transparent;

            HorizontalLayout {
                padding-left: 4px;
                padding-right: 6px;
                spacing: 7px;

                Rectangle {
                    width: 22px;
                    height: 22px;
                    y: 2px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: Palette.border;
                    background: Palette.slot-bg;

                    if member.has-image: Image {
                        x: 1px;
                        y: 1px;
                        width: 20px;
                        height: 20px;
                        source: member.image;
                        image-fit: contain;
                    }

                    if !member.has-image: Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: member.role-color;
                    }
                }

                Text {
                    text: member.name;
                    color: member.me ? Palette.gold-bright : (member.assigned ? Palette.text : Palette.muted);
                    font-size: 12px;
                    font-weight: member.me ? 700 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Text {
                    text: member.role;
                    color: member.role-color;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component Field inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> enabled: true;
    in property <bool> upper;
    callback accepted();
    callback edited(string);

    height: 52px;
    forward-focus: input;

    VerticalLayout {
        spacing: 4px;

        Text {
            text: root.label;
            color: Palette.muted;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
        }

        Rectangle {
            height: 32px;
            border-radius: 4px;
            border-width: 1px;
            border-color: input.has-focus ? Palette.gold : Palette.border;
            background: Palette.slot-bg;

            if root.text == "" && !input.has-focus: Text {
                x: 10px;
                text: root.placeholder;
                color: #6d5f4b;
                font-size: 13px;
                vertical-alignment: center;
                height: parent.height;
            }

            input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text <=> root.text;
                enabled: root.enabled;
                color: Palette.text;
                selection-background-color: #6b5230;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                accepted => { root.accepted(); }
                edited => { root.edited(self.text); }
            }
        }
    }

    public function focus-input() {
        input.focus();
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <color> accent: Palette.gold;
    callback clicked();

    height: 26px;
    min-width: chip-text.preferred-width + 18px;
    border-radius: 13px;
    border-width: 1px;
    border-color: selected ? accent : (touch.has-hover ? Palette.frame : Palette.border);
    background: selected ? accent.with-alpha(0.16) : Palette.slot-bg;

    chip-text := Text {
        text: root.text;
        color: root.selected ? root.accent : Palette.muted;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.8px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    min-width: 88px;
    border-radius: 4px;
    border-width: 1px;
    border-color: primary ? Palette.gold : Palette.border;
    background: primary ? (touch.has-hover && enabled ? #5a4325 : #3d2d19) : (touch.has-hover ? Palette.slot-hover : Palette.slot-bg);
    opacity: enabled ? 1.0 : 0.5;

    Text {
        text: root.text;
        color: root.primary ? Palette.gold-bright : Palette.text;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.4px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Ventana para entrar a una asignación. Es una ventana normal (con foco) porque
// hay que escribir; se usa fuera de las peleas.
export component SetupWindow inherits Window {
    in-out property <string> code;
    in-out property <string> name;
    in-out property <int> role-index: -1;
    in-out property <int> lang-index: 0;
    in property <string> error-text;
    in property <string> info-text;
    in property <bool> busy;
    in property <bool> joined;
    in property <[string]> roles: ["TANK", "HEALER", "SUPPORT", "RANGE DPS", "MELEE DPS", "BATTLE MOUNT"];
    in property <[color]> role-colors: [#6aa8ff, #45d6a0, #f0a830, #ff9a62, #ff7a6b, #c9b48f];

    callback submit();
    callback leave();
    callback close-clicked();

    title: "AlbionCompo · Entrar a la asignación";
    always-on-top: true;
    default-font-family: "Segoe UI";
    background: Palette.bg;
    width: 380px;
    height: 452px;

    forward-focus: code-field;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        Text {
            text: "ALBIONCOMPO";
            color: Palette.gold;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2.4px;
        }

        Text {
            text: "Pedile el código a quien lidera la party. Te anotás con tu nombre y rol, y cuando te asigne una build la vas a ver arriba del juego.";
            color: Palette.muted;
            font-size: 12px;
            wrap: word-wrap;
        }

        code-field := Field {
            label: "CÓDIGO DE LA ASIGNACIÓN";
            placeholder: "Ej.: D75TGV";
            text <=> root.code;
            enabled: !root.busy;
            accepted => { name-field.focus-input(); }
        }

        name-field := Field {
            label: "TU NOMBRE EN EL JUEGO";
            placeholder: "Ej.: Dusius";
            text <=> root.name;
            enabled: !root.busy;
            accepted => { root.submit(); }
        }

        Text {
            text: "ROL (OPCIONAL)";
            color: Palette.muted;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
        }

        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                for i in 3: Chip {
                    text: root.roles[i];
                    accent: root.role-colors[i];
                    selected: root.role-index == i;
                    clicked => { root.role-index = root.role-index == i ? -1 : i; }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                for i in 3: Chip {
                    text: root.roles[i + 3];
                    accent: root.role-colors[i + 3];
                    selected: root.role-index == i + 3;
                    clicked => { root.role-index = root.role-index == i + 3 ? -1 : i + 3; }
                }
            }
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Text {
                text: "NOMBRES DE ÍTEMS";
                color: Palette.muted;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1.2px;
                vertical-alignment: center;
            }

            Rectangle {
                width: 4px;
            }

            for lang[i] in ["ES", "EN", "PT"]: Chip {
                text: lang;
                selected: root.lang-index == i;
                clicked => { root.lang-index = i; }
            }
        }

        Text {
            text: root.error-text != "" ? root.error-text : root.info-text;
            color: root.error-text != "" ? Palette.error : Palette.muted;
            font-size: 12px;
            wrap: word-wrap;
            min-height: 16px;
        }

        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            spacing: 8px;

            if root.joined: Button {
                text: "SALIR";
                enabled: !root.busy;
                clicked => { root.leave(); }
            }

            Button {
                text: "CERRAR";
                clicked => { root.close-clicked(); }
            }

            Button {
                text: root.busy ? "ENTRANDO..." : "ENTRAR";
                primary: true;
                enabled: !root.busy;
                horizontal-stretch: 2;
                clicked => { root.submit(); }
            }
        }
    }
}
